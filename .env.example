# Copy this file to .env and fill in your actual values.
# Never commit .env to the repository.

# --- LLM Provider API Keys (set the one matching your config.yaml llm.provider) ---

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — free tier available (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIza...

# Groq — free tier available (https://console.groq.com/)
GROQ_API_KEY=gsk_...

# --- Telegram Delivery ---

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAF...

# Chat ID to deliver the digest to (use @userinfobot to find yours)
TELEGRAM_CHAT_ID=-100123456789
