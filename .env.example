# Copy this file to .env and fill in your actual values.
# Never commit .env to the repository.

# --- LLM Provider API Keys (set the ones matching your config.yaml llm.providers) ---

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — free tier available (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIza...

# Groq — free tier available (https://console.groq.com/)
GROQ_API_KEY=gsk_...

# Mistral AI (https://console.mistral.ai/api-keys/)
# MISTRAL_API_KEY=...

# DeepSeek (https://platform.deepseek.com/api_keys)
# DEEPSEEK_API_KEY=...

# --- Telegram Delivery ---

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAF...

# Chat ID to deliver the digest to (use @userinfobot to find yours)
TELEGRAM_CHAT_ID=-100123456789

# --- Reddit OAuth (optional — enables Reddit counter-signal source) ---
# Register a "script" app at https://www.reddit.com/prefs/apps
# User-Agent format: script:digest-bot:2.0 (by /u/<your_username>)
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...
# REDDIT_USERNAME=your_reddit_username
